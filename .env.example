# ---- UTAX Finance CRM ----
PORT=8100
HOST=127.0.0.1
NODE_ENV=production

# SQLite fayl (PostgreSQL uchun DB_DRIVER=postgres, DATABASE_URL=... — docs/ARCHITECTURE.md)
DB_PATH=./data/finance.db

# JWT (kamida 32 belgi, tasodifiy)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Maxfiy sozlamalar (integratsiya credentiallari) shu kalit bilan shifrlanadi (AES-256-GCM)
SECRETS_KEY=change-me-32-bytes-hex-or-any-long-string

# Vaqt zonasi: fon vazifalari (01:00 revenue, 03:00 backup, 08:30 digest) va "bugun" sanasi shu zonada.
# TZ o'rnatilgan bo'lsa — TZ ustun.
APP_TZ=Asia/Tashkent

# ---- AI (erkin matn, 4 bot + web "AI moliya") ----
# Gemini asosiy, xato/limit bo'lsa Groq; ikkalasi ham bo'lmasa — qoidalar dvigateli (xato foydalanuvchiga ko'rinmaydi).
# Kalitlarni tekshirish (kalit ekranga chiqmaydi): npm run llm:check
# Faqat UTAX ma'lumotlari (RBAC bilan filtrlangan tool'lar), mijoz/xodim nomlari LLM'ga niqoblangan holda ketadi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Asosiy model topilmasa (404) navbatdagilari, vergul bilan (bo'sh = config default)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
# Gemini'ga daqiqasiga eng ko'p so'rov (bepul tarif kvotasi kalit bo'yicha); tugasa Groq ishlaydi
GEMINI_RPM=12
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq TPM limiti har model uchun alohida — asosiy model limitga yetsa shu model
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Mijoz/xodim nomlari → MIJOZ_n / XODIM_n, INN/telefon/hisob → *** (javobda nomlar qaytariladi)
AI_MASK_NAMES=true
# Suhbat xotirasi: oxirgi N savol-javob, necha soat ichida (/clear tozalaydi)
AI_MEMORY_TURNS=6
AI_MEMORY_HOURS=12
# Bitta so'rovga eng ko'p tool (token tejash) va javob kutish chegarasi
AI_MAX_TOOLS=8
AI_TIMEOUT_MS=25000

# ---- Telegram botlar (src/bots, docs/BOTS.md) ----
# @BotFather tokenlari. Bo'sh bot ishga tushmaydi (qolganlari ishlayveradi).
BOT_RAHBAR_TOKEN=
BOT_BUXGALTER_TOKEN=
BOT_SOROV_TOKEN=
BOT_SIGNAL_TOKEN=
# Egalar — Telegram user id'lar (vergul bilan): FOUNDER roli, barcha 4 botga to'liq kirish, kodsiz bog'lanadi
BOT_OWNER_IDS=
# polling (lokal, default) | webhook (prod: PUBLIC_URL https + WEBHOOK_SECRET) | off
BOT_MODE=polling
PUBLIC_URL=
# Botlardagi "Web'da ochish" tugmalari manzili. https bo'lsa — Telegram Mini App (ichida avtomatik kirish)
WEBAPP_URL=
# Webhook maxfiy sarlavhasi (A-Z a-z 0-9 _ -), masalan: openssl rand -hex 24
WEBHOOK_SECRET=
# CRITICAL ogohlantirishlar guruhi (ixtiyoriy, -100… chat id). Bir xil ogohlantirish guruhga bir marta (dedupe_key bo'yicha)
TELEGRAM_ALERT_CHAT_ID=

# Email (ixtiyoriy — webhook orqali yuboriladi)
EMAIL_WEBHOOK_URL=

# DEMO (pilot) ma'lumot: faqat sinov uchun true. Prod — false (standart): bo'sh baza bo'sh qoladi,
# haqiqiy ma'lumot UTAX Excel jurnalidan: npm run import:excel -- <fayl.xlsx> [--db data/finance.db] [--reset] [--dry-run]
SEED_ON_EMPTY=false

# Web uchun birinchi administrator (FOUNDER) — server ishga tushganda yaratiladi (bor bo'lsa FOUNDER/faol qilinadi).
# ADMIN_PASSWORD kamida 8 belgi; berilsa va joriy paroldan farq qilsa — yangilanadi (sessiyalar yopiladi). Bo'sh — mavjud parolga tegilmaydi.
# Parol logga chiqmaydi. Kirgandan keyin parolni UI'da o'zgartirsangiz, bu yerdagini o'chiring yoki yangilang.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Vercel / Turso (DEPLOY-VERCEL.md) ---
# Berilsa baza Turso'da (libSQL embedded replica). Bo'sh bo'lsa lokal data/finance.db (node:sqlite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Cron → GET /api/cron/tick (Authorization: Bearer <CRON_SECRET>). Tashqi cron ham shu kalit bilan ishlaydi.
CRON_SECRET=
# Faqat lokal tekshiruv uchun: libSQL drayverini sinxronlashsiz majburlash (npm run vercel:check o'zi qo'yadi)
# DB_DRIVER=libsql
