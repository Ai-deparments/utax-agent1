{
  "name": "utax-finance-crm",
  "version": "1.0.0",
  "description": "UTAX AI Moliya CRM — Finance Operating System (MVP)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "seed": "node src/seed/seed.mjs",
    "seed:reset": "node src/seed/seed.mjs --reset",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "backup": "bash deploy/backup.sh",
    "openapi": "node -e \"import('./src/server.mjs').then(m=>console.log(JSON.stringify(m.buildOpenApi(),null,2)))\"",
    "check": "node scripts/check.mjs",
    "llm:check": "node scripts/llm-check.mjs",
    "import:excel": "node scripts/excel-import.mjs",
    "vercel:check": "node scripts/vercel-check.mjs",
    "vault:pack": "node scripts/data-vault.mjs pack",
    "vault:unpack": "node scripts/data-vault.mjs unpack",
    "vault:verify": "node scripts/data-vault.mjs verify",
    "erp:token:seal": "node scripts/erp-token.mjs seal",
    "erp:token:show": "node scripts/erp-token.mjs show",
    "erp:setup": "node scripts/erp-import.mjs && node scripts/erp-full.mjs && node scripts/erp-map.mjs",
    "erp:sync": "node scripts/erp-import.mjs",
    "erp:full": "node scripts/erp-full.mjs",
    "erp:map": "node scripts/erp-map.mjs",
    "turso:check": "node scripts/turso-check.mjs",
    "turso:push": "node scripts/turso-push.mjs"
  },
  "license": "UNLICENSED",
  "optionalDependencies": {
    "libsql": "^0.5.29"
  }
}
