{
  "name": "utax-finance-crm",
  "version": "1.0.0",
  "description": "UTAX AI Moliya CRM — Finance Operating System (MVP)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "seed": "node src/seed/seed.mjs",
    "seed:reset": "node src/seed/seed.mjs --reset",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "backup": "bash deploy/backup.sh",
    "openapi": "node -e \"import('./src/server.mjs').then(m=>console.log(JSON.stringify(m.buildOpenApi(),null,2)))\"",
    "check": "node scripts/check.mjs",
    "llm:check": "node scripts/llm-check.mjs",
    "import:excel": "node scripts/excel-import.mjs",
    "vercel:check": "node scripts/vercel-check.mjs"
  },
  "license": "UNLICENSED",
  "optionalDependencies": {
    "libsql": "^0.5.29"
  }
}
