{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "buildCommand": "mkdir -p .vercel-static && echo 'UTAX Finance: barcha so‘rovlar api/index.mjs orqali' > .vercel-static/build-info.txt",
  "outputDirectory": ".vercel-static",
  "regions": ["fra1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{public/**,src/**,package.json,node_modules/libsql/**,node_modules/@libsql/**,node_modules/@neon-rs/**,node_modules/detect-libc/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/cron/tick", "schedule": "30 4 * * *" }]
}
